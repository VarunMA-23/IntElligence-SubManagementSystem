    "@brightloop/integrations": "workspace:*",
    "@brightloop/metering": "workspace:*",
    "@brightloop/shared": "workspace:*",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "mongodb-memory-server": "^10.1.3",
    "tsup": "^8.3.5"
  }
