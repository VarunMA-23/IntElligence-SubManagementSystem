{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "apps/web", "**/dist", "**/.next"]
}
