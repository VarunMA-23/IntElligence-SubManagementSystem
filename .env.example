NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/brightloop
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAILER_TRANSPORT=console
MAILER_SMTP_HOST=localhost
MAILER_SMTP_PORT=1025
MAILER_FROM="BrightLoop <no-reply@brightloop.local>"
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=5000
ALLOW_LOCAL_WEBHOOKS=true
INTERNAL_SECRET=local-internal-secret
PORTAL_TOKEN_TTL_MINUTES=1440
STORAGE_DIR=./storage
